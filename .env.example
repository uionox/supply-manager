# Copy to .env and fill in. Never commit the real .env.

# Required. The admin sign-in password, in plain text — whoever can read
# this variable (server access, Coolify's env var UI, etc.) can read the
# password itself, not just verify against it. Fine for a small trusted
# group; pick something not reused elsewhere.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie. If left unset, a random key is
# generated once and stored at instance/secret_key — which is fine, and means
# there is no shared default anyone could use to forge an admin session.
# Set it explicitly only if you want the same key across several machines:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Keep the admin cookie off plain HTTP. Only set this to 0 for local
# development, never on the server.
SESSION_COOKIE_SECURE=1

# Set to 1 when Caddy (or any reverse proxy) sits in front, so the real
# visitor IP is used for login throttling instead of 127.0.0.1.
# Leave at 0 if the app is exposed directly, or the header can be spoofed.
TRUST_PROXY=1

# Timezone claim timestamps are shown in. Storage is always UTC.
DISPLAY_TIMEZONE=Asia/Beirut

# Optional. Defaults to <project>/instance/supply.db
# DATABASE_PATH=/var/lib/supply-manager/supply.db

# Optional. Shown in the header and page titles.
SITE_TITLE=Camp Supply Tracker
