# Copy to .env and fill in. Never commit the real .env.

# Signs the admin session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Generate with:
#   flask --app wsgi hash-password "your-admin-password"
ADMIN_PASSWORD_HASH=

# Optional. Defaults to <project>/instance/supply.db
# DATABASE_PATH=/var/lib/supply-manager/supply.db

# Optional. Shown in the header and page titles.
SITE_TITLE=Camp Supply Tracker
